{
  "extends": "./tsconfig.app.json",

  // Override to include only test files and clear exclusions. The ambient
  // declarations come along: a test reaches `seedrandom` through the
  // application code, and its module declaration is only seen when included.
  "include": ["src/**/__tests__/**/*", "src/**/*.d.ts"],
  "exclude": [],

  "compilerOptions": {
    // The suite runs in jsdom, on the same target as the application: the libs
    // match the app, so a test cannot call an API the browser does not have.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "jsdom"],

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
